{
  // Makima theme: crimson / ember orange / gold eyes
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "source": "~/.config/fastfetch/mommy.jpg",
       // kitty/ghostty/wezterm. Use "sixel" (foot) or "chafa" otherwise
    "width": 34,
    "padding": { "top": 1, "left": 2, "right": 4 }
  },

  "display": {
    "separator": "  ",
    "key": { "width": 14 },
    "color": {
      "keys": "38;2;220;20;60",
      "title": "38;2;255;110;50",
      "separator": "38;2;230;190;60",
      "output": "38;2;235;225;225"
    }
  },

  "modules": [
    "break",
    {
      "type": "title",
      "format": "{#38;2;255;110;50}{user-name}{#38;2;230;190;60}@{#38;2;220;20;60}{host-name}"
    },
    {
      "type": "custom",
      "format": "{#38;2;110;20;35}──────────────────────────────────────"
    },

    // ── System ──
    {
      "type": "custom",
      "format": "{#38;2;220;20;60}╭─── {#38;2;230;190;60}System {#38;2;220;20;60}──────────────────────╮"
    },
    { "type": "os",       "key": "│  OS",       "keyColor": "38;2;220;20;60" },
    { "type": "kernel",   "key": "│  Kernel",   "keyColor": "38;2;220;20;60" },
    { "type": "uptime",   "key": "│  Uptime",   "keyColor": "38;2;220;20;60" },
    { "type": "packages", "key": "│  Packages", "keyColor": "38;2;220;20;60" },
    { "type": "shell",    "key": "│  Shell",    "keyColor": "38;2;220;20;60" },

    // ── Desktop ──
    {
      "type": "custom",
      "format": "{#38;2;255;110;50}├─── {#38;2;230;190;60}Desktop {#38;2;255;110;50}────────────────────┤"
    },
    { "type": "wm",       "key": "│  WM",       "keyColor": "38;2;255;110;50" },
    { "type": "de",       "key": "│  DE",       "keyColor": "38;2;255;110;50" },
    { "type": "terminal", "key": "│  Terminal", "keyColor": "38;2;255;110;50" },
    { "type": "font",     "key": "│  Font",     "keyColor": "38;2;255;110;50" },

    // ── Hardware ──
    {
      "type": "custom",
      "format": "{#38;2;230;190;60}├─── {#38;2;230;190;60}Hardware {#38;2;230;190;60}───────────────────┤"
    },
    { "type": "cpu",     "key": "│  CPU",     "keyColor": "38;2;230;190;60" },
    { "type": "gpu",     "key": "│  GPU",     "keyColor": "38;2;230;190;60" },
    { "type": "memory",  "key": "│  Memory",  "keyColor": "38;2;230;190;60" },
    { "type": "disk",    "key": "│  Disk",    "keyColor": "38;2;230;190;60", "folders": "/" },
    { "type": "battery", "key": "│  Battery", "keyColor": "38;2;230;190;60" },

    {
      "type": "custom",
      "format": "{#38;2;220;20;60}╰───────────────────────────────────╯"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 2,
      "block": { "width": 3 }
    }
  ]
}
